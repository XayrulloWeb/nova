generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model applications {
  id           Int      @id @default(autoincrement())
  parent_name  String   @db.VarChar(255)
  parent_phone String   @db.VarChar(255)
  child_name   String   @db.VarChar(255)
  child_dob    DateTime @db.Date
  grade        String   @db.VarChar(50)
  status       String   @default("NEW") @db.VarChar(50)
  comment      String?  @db.Text
  created_at   DateTime @default(now()) @db.Timestamp(6)
  contract     contracts?
  payments     payments[]
}

model contracts {
  id                         Int          @id @default(autoincrement())
  application_id             Int          @unique
  application                applications @relation(fields: [application_id], references: [id], onDelete: Cascade)
  contract_number            String       @db.VarChar(50)
  contract_date              DateTime     @db.Date
  academic_year              String       @db.VarChar(50)
  
  parent_passport_series     String       @db.VarChar(10)
  parent_passport_number     String       @db.VarChar(50)
  parent_passport_issue_date DateTime     @db.Date
  parent_passport_issued_by  String       @db.VarChar(255)
  parent_pinfl               String       @db.VarChar(14)
  parent_dob                 DateTime     @db.Date
  parent_address             String       @db.Text
  
  child_doc_series           String       @db.VarChar(10)
  child_doc_number           String       @db.VarChar(50)
  child_doc_issue_date       DateTime     @db.Date
  child_doc_issued_by        String       @db.VarChar(255)
  
  monthly_fee                String       @db.VarChar(50)
  
  created_at                 DateTime     @default(now()) @db.Timestamp(6)
}

model administration {
  id                Int      @id @default(autoincrement())
  name              Json?
  role              Json?
  desc              Json?
  image_url         String?  @db.VarChar(255)
  experience_years  String?  @db.VarChar(50)
  experience_period String?  @db.VarChar(50)
  awards            Json?
  created_at        DateTime @default(now()) @db.Timestamp(6)
}

model contacts {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  phone      String   @db.VarChar(50)
  message    String
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model admins {
  id            Int      @id @default(autoincrement())
  username      String   @unique @db.VarChar(50)
  password_hash String   @db.VarChar(255)
  role          String   @default("ADMIN") @db.VarChar(50) // Added role for SUPERADMIN/ADMIN
  created_at    DateTime @default(now()) @db.Timestamp(6)
}

model news {
  id         Int      @id @default(autoincrement())
  title      Json?
  content    Json?
  image_url  String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model teachers {
  id         Int      @id @default(autoincrement())
  name       Json?
  title      Json?
  desc       Json?
  tags       Json?
  subject    Json?
  image_url  String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model stats {
  id               Int      @id @default(autoincrement())
  students_count   String   @db.VarChar(50)
  experience_years String   @db.VarChar(50)
  graduates_count  String   @db.VarChar(50)
  updated_at       DateTime @default(now()) @db.Timestamp(6)
}

model gallery {
  id         Int      @id @default(autoincrement())
  image_url  String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model payments {
  id             Int          @id @default(autoincrement())
  application_id Int
  application    applications @relation(fields: [application_id], references: [id], onDelete: Cascade)
  amount         String       @db.VarChar(50)
  payment_month  String       @db.VarChar(50) // e.g. "Сентябрь 2026"
  payment_method String       @db.VarChar(50) // e.g. "Наличные", "Терминал", "Перевод"
  comment        String?      @db.Text
  created_at     DateTime     @default(now()) @db.Timestamp(6)
}
