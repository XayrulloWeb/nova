generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model applications {
  id           Int      @id @default(autoincrement())
  parent_name  String   @db.VarChar(255)
  parent_phone String   @db.VarChar(255)
  child_name   String   @db.VarChar(255)
  child_dob    DateTime @db.Date
  grade        String   @db.VarChar(50)
  created_at   DateTime @default(now()) @db.Timestamp(6)
}

model administration {
  id         Int      @id @default(autoincrement())
  name_uz    String   @db.VarChar(255)
  name_ru    String   @db.VarChar(255)
  role_uz    String   @db.VarChar(255)
  role_ru    String   @db.VarChar(255)
  desc_uz    String?  @db.Text
  desc_ru    String?  @db.Text
  image_url  String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model contacts {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  phone      String   @db.VarChar(50)
  message    String
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model admins {
  id            Int      @id @default(autoincrement())
  username      String   @unique @db.VarChar(50)
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(6)
}

model news {
  id         Int      @id @default(autoincrement())
  title_uz   String   @db.VarChar(255)
  title_ru   String   @db.VarChar(255)
  content_uz String
  content_ru String
  image_url  String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model teachers {
  id         Int      @id @default(autoincrement())
  name_uz    String   @db.VarChar(255)
  name_ru    String   @db.VarChar(255)
  title_uz   String?  @db.VarChar(255)
  title_ru   String?  @db.VarChar(255)
  desc_uz    String?  @db.Text
  desc_ru    String?  @db.Text
  tags_uz    String?  @db.VarChar(255)
  tags_ru    String?  @db.VarChar(255)
  subject_uz String   @db.VarChar(255)
  subject_ru String   @db.VarChar(255)
  image_url  String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model stats {
  id               Int      @id @default(autoincrement())
  students_count   String   @db.VarChar(50)
  experience_years String   @db.VarChar(50)
  graduates_count  String   @db.VarChar(50)
  updated_at       DateTime @default(now()) @db.Timestamp(6)
}
