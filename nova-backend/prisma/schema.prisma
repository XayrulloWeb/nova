generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model applications {
  id           Int      @id @default(autoincrement())
  parent_name  String   @db.VarChar(255)
  parent_phone String   @db.VarChar(255)
  child_name   String   @db.VarChar(255)
  child_dob    DateTime @db.Date
  grade        String   @db.VarChar(50)
  status       String   @default("NEW") @db.VarChar(50)
  comment      String?  @db.Text
  created_at   DateTime @default(now()) @db.Timestamp(6)
}

model administration {
  id                Int      @id @default(autoincrement())
  name              Json?
  role              Json?
  desc              Json?
  image_url         String?  @db.VarChar(255)
  experience_years  String?  @db.VarChar(50)
  experience_period String?  @db.VarChar(50)
  awards            Json?
  created_at        DateTime @default(now()) @db.Timestamp(6)
}

model contacts {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  phone      String   @db.VarChar(50)
  message    String
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model admins {
  id            Int      @id @default(autoincrement())
  username      String   @unique @db.VarChar(50)
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(6)
}

model news {
  id         Int      @id @default(autoincrement())
  title      Json?
  content    Json?
  image_url  String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model teachers {
  id         Int      @id @default(autoincrement())
  name       Json?
  title      Json?
  desc       Json?
  tags       Json?
  subject    Json?
  image_url  String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model stats {
  id               Int      @id @default(autoincrement())
  students_count   String   @db.VarChar(50)
  experience_years String   @db.VarChar(50)
  graduates_count  String   @db.VarChar(50)
  updated_at       DateTime @default(now()) @db.Timestamp(6)
}

model gallery {
  id         Int      @id @default(autoincrement())
  image_url  String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)
}
